#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOLS_DIR="$ROOT_DIR/.tools"
MAVEN_DIR="$TOOLS_DIR/apache-maven-3.9.9"
MAVEN_ZIP="$TOOLS_DIR/apache-maven-3.9.9-bin.tar.gz"
MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz"

if [ ! -x "$MAVEN_DIR/bin/mvn" ]; then
  mkdir -p "$TOOLS_DIR"
  curl -fsSL "$MAVEN_URL" -o "$MAVEN_ZIP"
  tar -xzf "$MAVEN_ZIP" -C "$TOOLS_DIR"
fi

"$MAVEN_DIR/bin/mvn" "$@"
